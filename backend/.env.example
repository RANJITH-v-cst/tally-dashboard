# URL of the TallyPrime / Tally ERP 9 HTTP/XML gateway.
# Default: http://localhost:9000 (Tally running on the same machine).
TALLY_URL=http://localhost:9000

# HTTP timeout, in seconds, for requests to the Tally gateway.
TALLY_TIMEOUT=30

# Comma-separated list of origins allowed by CORS.
# Use "*" during local development.
CORS_ORIGINS=*
