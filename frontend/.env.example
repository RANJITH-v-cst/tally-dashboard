# Base URL of the FastAPI backend. Leave unset in local dev to use the
# Vite dev-server proxy (forwards /api to http://127.0.0.1:8787).
# VITE_API_URL=http://localhost:8787/api

# Override the Tally URL the backend proxies to during `npm run dev`.
# VITE_BACKEND_URL=http://127.0.0.1:8787

# Supabase authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
